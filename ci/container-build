#!/usr/bin/env bash
# Run the Rust or desktop packaging checks in the pinned Fedora builder image.
# The repository is the only source bind mount; all mutable tool caches and the
# container home are unique to this invocation and are removed on exit. Cargo
# writes to target/fedora43 so host and Fedora outputs cannot be mixed.
set -Eeuo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT_DIR"

usage() {
  cat <<'EOF'
Usage: ci/container-build <rust|package>

The command builds ci/Dockerfile.fedora, then runs the selected existing
entrypoint inside it. Docker-compatible container tooling is required. The
wrapper does not mount a host home directory, ~/.cargo, or a Docker socket.
EOF
}

die() {
  printf 'ci/container-build: %s\n' "$*" >&2
  exit 1
}

mode=${1:-}
case "$mode" in
  rust|package)
    ;;
  ''|-h|--help)
    usage
    [[ -n "$mode" ]] && exit 0 || exit 2
    ;;
  *)
    usage >&2
    die "unknown build mode: $mode"
    ;;
esac

engine=${APP_MANAGER_CONTAINER_ENGINE:-docker}
command -v "$engine" >/dev/null 2>&1 || die "container engine is unavailable: $engine"

case "$engine" in
  docker|podman)
    ;;
  *)
    die 'APP_MANAGER_CONTAINER_ENGINE must be docker or podman'
    ;;
esac

# Bind mounts are owned by the caller. Build the disposable image account with
# the same IDs so npm/Cargo caches and generated artifacts remain usable after
# the container exits. A root caller would defeat that ownership boundary and
# is deliberately rejected; use an ordinary local account instead.
host_uid=$(id -u)
host_gid=$(id -g)
if [[ "$host_uid" == 0 || "$host_gid" == 0 ]]; then
  die 'ci/container-build requires a non-root caller (UID and GID must be non-zero)'
fi

raw_repo=${GITHUB_REPOSITORY:-app-manager}
repo_name=${raw_repo##*/}
repo_name=$(printf '%s' "$repo_name" | tr -c 'A-Za-z0-9_.-' '-')
[[ -n "$repo_name" ]] || repo_name=app-manager

raw_run=${GITHUB_RUN_ID:-local-$$}
run_name=$(printf '%s' "$raw_run" | tr -c 'A-Za-z0-9_.-' '-')
[[ -n "$run_name" ]] || run_name=local

cache_parent=${RUNNER_TEMP:-${TMPDIR:-/tmp}}
mkdir -p "$cache_parent"
cache_root=$(mktemp -d "$cache_parent/app-manager-${repo_name}-${run_name}.XXXXXX")
cleanup() {
  rm -rf -- "$cache_root"
}
trap cleanup EXIT

mkdir -p "$cache_root/cargo" "$cache_root/npm" "$cache_root/home"
chmod 700 "$cache_root" "$cache_root/cargo" "$cache_root/npm" "$cache_root/home"

image_ref="app-manager-fedora43-builder:${repo_name}-${run_name}"
"$engine" build \
  --build-arg "APP_MANAGER_UID=${host_uid}" \
  --build-arg "APP_MANAGER_GID=${host_gid}" \
  --file "$ROOT_DIR/ci/Dockerfile.fedora" \
  --tag "$image_ref" \
  "$ROOT_DIR/ci"

inspect_image_user() {
  # Inspect the account as image root, including the intentionally unusable
  # password and the fixture's password-authentication policy.
  "$engine" run --rm "$image_ref" bash -Eeuo pipefail -c '
    expected_uid=$1
    expected_gid=$2
    [[ "$(id -u appmanager)" == "$expected_uid" ]]
    [[ "$(id -g appmanager)" == "$expected_gid" ]]
    [[ "$(getent passwd appmanager | cut -d: -f6)" == /home/appmanager ]]
    [[ "$(getent shadow appmanager | cut -d: -f2)" == "*" ]]
    grep -Fqx "PasswordAuthentication no" /etc/ssh/sshd_config.d/99-app-manager-ci.conf
  ' -- "$host_uid" "$host_gid"

  # Then instantiate with the exact caller IDs and require name resolution;
  # this catches an image that has numeric IDs but no usable passwd/group map.
  "$engine" run --rm --user "${host_uid}:${host_gid}" "$image_ref" \
    bash -Eeuo pipefail -c '
      expected_uid=$1
      expected_gid=$2
      [[ "$(id -u)" == "$expected_uid" ]]
      [[ "$(id -g)" == "$expected_gid" ]]
      [[ "$(id -un)" == appmanager ]]
      [[ "$(id -gn)" == appmanager ]]
    ' -- "$host_uid" "$host_gid"

  printf 'ci/container-build: verified appmanager uid=%s gid=%s\n' \
    "$host_uid" "$host_gid"
}

inspect_image_user

case "$mode" in
  rust)
    container_command=$'set -Eeuo pipefail\nnpm ci --prefix web --ignore-scripts\nci/check rust'
    ;;
  package)
    container_command=$'set -Eeuo pipefail\nnpm ci\nnpm ci --prefix web --ignore-scripts\nci/package\ntest -x "$CARGO_TARGET_DIR/release/app-manager-desktop"\ntest -f tests/desktop-smoke.py\nXvfb :99 -screen 0 1280x900x24 -nolisten tcp >/tmp/app-manager-xvfb.log 2>&1 &\nxvfb_pid=$!\nstop_xvfb() { kill "$xvfb_pid" 2>/dev/null || true; wait "$xvfb_pid" 2>/dev/null || true; }\ntrap stop_xvfb EXIT\nfor attempt in {1..20}; do kill -0 "$xvfb_pid" 2>/dev/null && break; sleep 0.1; done\nkill -0 "$xvfb_pid"\nsleep 1\nDISPLAY=:99 dbus-run-session -- python3 tests/desktop-smoke.py --binary "$CARGO_TARGET_DIR/release/app-manager-desktop"'
    ;;
esac

run_args=(
  run
  --rm
  --user "${host_uid}:${host_gid}"
  --workdir /workspace
  --mount "type=bind,src=${ROOT_DIR},dst=/workspace"
  --mount "type=bind,src=${cache_root}/cargo,dst=/cache/cargo"
  --mount "type=bind,src=${cache_root}/npm,dst=/cache/npm"
  --mount "type=bind,src=${cache_root}/home,dst=/home/appmanager"
  --env CI=true
  --env CARGO_HOME=/cache/cargo
  --env CARGO_TARGET_DIR=/workspace/target/fedora43
  --env CARGO_BUILD_JOBS=3
  --env APP_MANAGER_BUILDER_IMAGE="$image_ref"
  --env APP_MANAGER_BUILDER_BASE_DIGEST=sha256:2651ad743908b60acca6099f7a06ccb3602eb63a1b08cbd00cfa441a4d4afbe0
  --env npm_config_cache=/cache/npm
  --env RUSTUP_HOME=/opt/rustup
  --env RUSTUP_TOOLCHAIN=1.96.0
)

# Preserve identity and packaging knobs without importing arbitrary host
# environment state into the build container.
for variable in GITHUB_SHA GITHUB_REPOSITORY RELEASE_VERSION RELEASE_COMMIT TAURI_BUNDLES; do
  if [[ -n ${!variable+x} ]]; then
    run_args+=(--env "${variable}=${!variable}")
  fi
done

add_workspace_path_env() {
  local variable=$1
  command -v realpath >/dev/null 2>&1 || die "realpath is required when ${variable} is set"
  local value=${!variable}
  local value_abs
  value_abs=$(realpath -m -- "$value")
  case "$value_abs" in
    "$ROOT_DIR"/*)
      run_args+=(--env "${variable}=/workspace/${value_abs#"$ROOT_DIR"/}")
      ;;
    *)
      die "${variable} must be below the checkout when using ci/container-build"
      ;;
  esac
}

for variable in OUTPUT_DIR RELEASE_MANIFEST_PATH PACKAGE_EVIDENCE_PATH; do
  if [[ -n ${!variable:-} ]]; then
    add_workspace_path_env "$variable"
  fi
done

"$engine" "${run_args[@]}" "$image_ref" bash -Eeuo pipefail -c "$container_command"
